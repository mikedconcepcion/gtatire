---
---
<header class="bg-dark-900/80 backdrop-blur-md border-b border-dark-700/50 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-lg">GT</span>
        </div>
        <div class="hidden sm:block">
          <div class="text-white font-bold text-lg leading-tight">GTA Tire</div>
          <div class="text-dark-400 text-xs leading-tight">Distributor</div>
        </div>
      </a>

      <!-- Nav -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/tires" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Tires</a>
        <a href="/wheels" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Wheels</a>
        <a href="/search" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Search</a>
        <a href="/contact" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Contact</a>
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <a href="/login" class="text-dark-300 hover:text-white transition-colors text-sm font-medium hidden sm:block">
          Sign In
        </a>
        <a href="/login" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          Distributor Portal
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden text-dark-300 hover:text-white p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-dark-700/50">
    <div class="px-4 py-3 space-y-2">
      <a href="/tires" class="block text-dark-300 hover:text-white py-2 text-sm">Tires</a>
      <a href="/wheels" class="block text-dark-300 hover:text-white py-2 text-sm">Wheels</a>
      <a href="/search" class="block text-dark-300 hover:text-white py-2 text-sm">Search</a>
      <a href="/contact" class="block text-dark-300 hover:text-white py-2 text-sm">Contact</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
