---
---
<header class="bg-dark-800/90 backdrop-blur-md border-b border-primary-600/30 sticky top-0 z-50 shadow-sm shadow-black/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Logo -->
      <a href="/" class="inline-flex shrink-0" aria-label="JSDC Wheels home">
        <img
          src="/brand/jsdc-logo.png"
          srcset="/brand/jsdc-logo.png 1x, /brand/jsdc-logo@2x.png 2x"
          alt="JSDC Wheels"
          width="188"
          height="56"
          class="h-12 sm:h-14 w-auto"
        />
      </a>

      <!-- Search bar (desktop) -->
      <form id="header-search-form" action="/search/" class="hidden md:flex flex-1 max-w-md">
        <div class="relative w-full">
          <input
            type="text"
            name="q"
            placeholder="Search vehicle, brand, size..."
            class="w-full bg-dark-700/60 border border-dark-600 text-white rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent placeholder:text-dark-400"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </form>

      <!-- Nav -->
      <nav class="hidden md:flex items-center gap-5 shrink-0">
        <a href="/tires" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Tires</a>
        <a href="/wheels" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Wheels</a>
        <a href="/contact" class="text-dark-300 hover:text-white transition-colors text-sm font-medium">Contact</a>
        <a href="tel:+16476123341" class="inline-flex items-center gap-1.5 bg-primary-600 hover:bg-primary-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors shadow-lg shadow-primary-900/30" aria-label="Call JSDC Wheels">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-2.26 1.13a11 11 0 005.52 5.52l1.13-2.26a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" /></svg>
          647-612-3341
        </a>
      </nav>

      <!-- Mobile: search + menu -->
      <div class="flex items-center gap-2 md:hidden">
        <button id="mobile-search-btn" class="text-dark-300 hover:text-white p-2" aria-label="Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button id="mobile-menu-btn" class="text-dark-300 hover:text-white p-2" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile search bar -->
  <div id="mobile-search" class="hidden md:hidden border-t border-dark-700/50 px-4 py-3">
    <form action="/search/" class="relative">
      <input
        type="text"
        name="q"
        placeholder="Search vehicle, brand, size..."
        class="w-full bg-dark-800 border border-dark-700 text-white rounded-lg pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 placeholder:text-dark-500"
      />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </form>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden md:hidden border-t border-dark-700/50">
    <div class="px-4 py-3 space-y-2">
      <a href="/tires" class="block text-dark-300 hover:text-white py-2 text-sm">Tires</a>
      <a href="/wheels" class="block text-dark-300 hover:text-white py-2 text-sm">Wheels</a>
      <a href="/contact" class="block text-dark-300 hover:text-white py-2 text-sm">Contact</a>
      <a href="tel:+16476123341" class="block text-primary-400 hover:text-primary-300 py-2 text-sm font-semibold">Call 647-612-3341</a>
    </div>
  </nav>
</header>

<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
  document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
    const el = document.getElementById('mobile-search');
    el?.classList.toggle('hidden');
    if (!el?.classList.contains('hidden')) {
      el?.querySelector('input')?.focus();
    }
  });
</script>
