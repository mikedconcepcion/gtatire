---
interface Props {
  id: string;
  image: string;
  brand: string;
  model: string;
  description: string;
  size: string;
  msrp: string;
  stock: string;
  type: string;
  category: 'tire' | 'wheel';
}

const { id, image, brand, model, description, size, msrp, stock, type, category } = Astro.props;

const typeColors: Record<string, string> = {
  'All Season': 'bg-green-500/10 text-green-400 border-green-500/20',
  'Winter': 'bg-blue-400/10 text-blue-400 border-blue-400/20',
  'All Weather': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  'Steel Wheel': 'bg-dark-500/10 text-dark-300 border-dark-500/20',
  'Alloy Wheel': 'bg-primary-500/10 text-primary-400 border-primary-500/20',
};
const typeClass = typeColors[type] || 'bg-dark-700/50 text-dark-300 border-dark-600';

const stockNum = parseInt(stock);
const inStock = stock === '20+' || stockNum >= 10;
const lowStock = stockNum >= 1 && stockNum < 10;
const contactUs = stock === 'Contact us';
const stockColor = inStock
  ? 'text-green-400'
  : lowStock
    ? 'text-amber-400'
    : contactUs
      ? 'text-dark-400'
      : 'text-red-400';
const stockLabel = inStock ? 'In Stock' : contactUs ? 'Contact Us' : lowStock ? `${stock} left` : stock;
---

<a href={`/gtatire/${category}s/${id}`} class="group bg-dark-900 border border-dark-700/50 rounded-xl overflow-hidden hover:border-primary-600/40 transition-all hover:shadow-lg hover:shadow-primary-900/10">
  <!-- Image -->
  <div class="aspect-square bg-white rounded-t-xl flex items-center justify-center p-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    {image && !image.includes('sample') ? (
      <img src={image} alt={description} class="w-full h-full object-contain mix-blend-multiply" loading="lazy" decoding="async" />
    ) : (
      <svg class="w-24 h-24 text-dark-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke-width="1.5" />
        <circle cx="12" cy="12" r="6" stroke-width="1" />
        <circle cx="12" cy="12" r="2" stroke-width="1.5" />
      </svg>
    )}
    <!-- Type badge -->
    <span class={`absolute top-3 left-3 text-xs font-medium px-2.5 py-1 rounded-full border ${typeClass}`}>
      {type}
    </span>
  </div>

  <!-- Info -->
  <div class="p-3 sm:p-4">
    <h3 class="text-white font-semibold text-xs sm:text-sm mb-0.5 line-clamp-1 group-hover:text-primary-300 transition-colors">{model}</h3>
    <p class="text-dark-400 text-[11px] line-clamp-1 mb-2">{size}</p>

    <div class="flex items-end justify-between">
      <div class="text-white font-bold text-sm sm:text-lg">{msrp}</div>
      <div class={`text-[10px] sm:text-xs font-medium ${stockColor}`}>
        {stockLabel}
      </div>
    </div>
  </div>
</a>
