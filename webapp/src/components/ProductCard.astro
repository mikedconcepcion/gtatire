---
interface Props {
  id: string;
  image: string;
  brand: string;
  model: string;
  description: string;
  size: string;
  price: string;
  compareAt?: string;
  stock: string;
  type: string;
  category: 'tire' | 'wheel';
  noImage?: boolean;
}

const { id, image, brand, model, description, size, price, compareAt, stock, type, category, noImage } = Astro.props;

const typeColors: Record<string, string> = {
  'All Season': 'bg-green-500/10 text-green-400 border-green-500/20',
  'Winter': 'bg-blue-400/10 text-blue-400 border-blue-400/20',
  'All Weather': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  'Steel Wheel': 'bg-dark-500/10 text-dark-300 border-dark-500/20',
  'Alloy Wheel': 'bg-primary-500/10 text-primary-400 border-primary-500/20',
  'Alloy': 'bg-primary-500/10 text-primary-400 border-primary-500/20',
};
const typeClass = typeColors[type] || 'bg-dark-700/50 text-dark-300 border-dark-600';

const stockStr = String(stock || '').trim();
const stockNum = parseInt(stockStr, 10);
const outOfStock = /out of stock|no stock/i.test(stockStr) || /^n\/?a$/i.test(stockStr) || /discontinu/i.test(stockStr);
const contactStock = !outOfStock && /contact|call/i.test(stockStr);
const backorder = !outOfStock && !contactStock && /backorder|special order/i.test(stockStr);
const lowStock = !outOfStock && !contactStock && !backorder && !isNaN(stockNum) && stockNum >= 1 && stockNum < 10;
const stockLabel = outOfStock ? 'Out of Stock'
  : contactStock ? 'Contact for stock'
  : backorder ? stockStr
  : lowStock ? `${stockNum} left`
  : 'In Stock';
const stockColor = outOfStock ? 'text-red-400'
  : contactStock ? 'text-amber-400'
  : backorder ? 'text-amber-400'
  : lowStock ? 'text-amber-400'
  : 'text-green-400';

const showImage = image && !noImage;
const isTire = category === 'tire';
const priceNum = parseFloat(String(price).replace(/[^0-9.]/g, '')) || 0;
const inquiryName = `${brand || ''} ${model || ''}`.trim() || description;
---

<a href={`/${category}s/${id}`} itemscope itemtype="https://schema.org/Product" class="group bg-dark-900 border border-dark-700/50 rounded-xl overflow-hidden hover:border-primary-600/40 transition-all hover:shadow-lg hover:shadow-primary-900/10">
  <meta itemprop="sku" content={id} />
  {brand && <meta itemprop="brand" content={brand} />}
  <meta itemprop="category" content={category === 'tire' ? 'Tires' : 'Wheels'} />
  <meta itemprop="name" content={`${brand || ''} ${model || ''}`.trim() || description} />
  <!-- Image -->
  <div class="aspect-square bg-white rounded-t-xl flex items-center justify-center p-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    {showImage ? (
      <img src={image} alt={description} class="w-full h-full object-contain mix-blend-multiply" loading="lazy" decoding="async" />
    ) : isTire ? (
      <svg class="w-20 h-20 text-dark-400" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
        <ellipse cx="50" cy="50" rx="45" ry="48" />
        <ellipse cx="50" cy="50" rx="30" ry="32" />
        <line x1="20" y1="15" x2="35" y2="25" /><line x1="80" y1="15" x2="65" y2="25" />
        <line x1="10" y1="50" x2="22" y2="50" /><line x1="90" y1="50" x2="78" y2="50" />
        <line x1="20" y1="85" x2="35" y2="75" /><line x1="80" y1="85" x2="65" y2="75" />
      </svg>
    ) : (
      <svg class="w-20 h-20 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke-width="1.5" />
        <circle cx="12" cy="12" r="6" stroke-width="1" />
        <circle cx="12" cy="12" r="2" stroke-width="1.5" />
      </svg>
    )}
    <!-- Type badge -->
    <span class={`absolute top-3 left-3 text-xs font-medium px-2.5 py-1 rounded-full border ${typeClass}`}>
      {type}
    </span>
  </div>

  <!-- Info -->
  <div class="p-3 sm:p-4">
    <h3 class="text-white font-semibold text-xs sm:text-sm mb-0.5 line-clamp-1 group-hover:text-primary-300 transition-colors">{model}</h3>
    <p class="text-dark-400 text-[11px] line-clamp-1 mb-2">{size}</p>

    <div class="flex items-end justify-between mb-2">
      <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <div class="text-white font-bold text-sm sm:text-lg" itemprop="price" content={priceNum.toFixed(2)}>{price}</div>
        <meta itemprop="priceCurrency" content="CAD" />
        <link itemprop="availability" href={outOfStock ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock'} />
        {compareAt && <div class="text-dark-500 text-[10px] line-through">{compareAt}</div>}
      </div>
      <div class={`text-[10px] sm:text-xs font-medium ${stockColor}`}>
        {stockLabel}
      </div>
    </div>
    <button
      type="button"
      class="jsdc-inquiry-trigger w-full inline-flex items-center justify-center gap-1 rounded-md font-semibold transition-colors px-2 py-1.5 text-[10px] sm:text-xs bg-primary-600/15 border border-primary-500/30 text-primary-200 hover:bg-primary-600/25 hover:text-white"
      data-inquiry-id={id}
      data-inquiry-name={inquiryName}
      data-inquiry-category={category}
      data-inquiry-image={image || ''}
      data-inquiry-size={size}
      data-inquiry-price={priceNum.toFixed(2)}
    >
      <svg class="w-3 h-3 jsdc-inquiry-plus" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <svg class="hidden w-3 h-3 jsdc-inquiry-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
      <span class="jsdc-inquiry-label">Add to Inquiry</span>
    </button>
  </div>
</a>
