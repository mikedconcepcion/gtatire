---
const cities = [
  { slug: 'toronto', name: 'Toronto' },
  { slug: 'scarborough', name: 'Scarborough' },
  { slug: 'mississauga', name: 'Mississauga' },
  { slug: 'brampton', name: 'Brampton' },
  { slug: 'markham', name: 'Markham' },
  { slug: 'vaughan', name: 'Vaughan' },
  { slug: 'north-york', name: 'North York' },
  { slug: 'richmond-hill', name: 'Richmond Hill' },
  { slug: 'etobicoke', name: 'Etobicoke' },
  { slug: 'oakville', name: 'Oakville' },
];
---
<footer class="bg-dark-900 border-t border-primary-600/30 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-flex mb-4" aria-label="JSDC Wheels home">
          <img
            src="/brand/jsdc-logo.png"
            srcset="/brand/jsdc-logo.png 1x, /brand/jsdc-logo@2x.png 2x"
            alt="JSDC Wheels"
            width="188"
            height="56"
            class="h-16 w-auto"
          />
        </a>
        <p class="text-dark-400 text-sm max-w-md">
          Premium tires and wheels for the Greater Toronto Area.
          Top brands, hub-centric fitment, 1-2 day delivery.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Catalog</h3>
        <ul class="space-y-2">
          <li><a href="/tires" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Tires</a></li>
          <li><a href="/wheels" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Wheels</a></li>
          <li><a href="/search" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Search</a></li>
          <li><a href="/about" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">About JSDC</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Contact</h3>
        <ul class="space-y-2">
          <li><a href="/contact" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Contact Us</a></li>
          <li><a href="/login" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Distributor Login</a></li>
          <li class="text-dark-500 text-sm">Greater Toronto Area, ON</li>
        </ul>
      </div>
    </div>

    <!-- Resources -->
    <div class="border-t border-dark-700/40 mt-8 pt-6">
      <h3 class="text-dark-500 text-xs font-semibold uppercase tracking-wider mb-3">Resources</h3>
      <div class="flex flex-wrap gap-x-4 gap-y-1.5">
        <a href="/winter-tires" class="text-dark-400 hover:text-primary-400 text-xs transition-colors">Winter tires</a>
        <a href="/all-season-tires" class="text-dark-400 hover:text-primary-400 text-xs transition-colors">All-season & all-weather</a>
        <a href="/guides/hub-centric-wheels" class="text-dark-400 hover:text-primary-400 text-xs transition-colors">Hub-centric guide</a>
        <a href="/guides/bolt-patterns" class="text-dark-400 hover:text-primary-400 text-xs transition-colors">Bolt patterns</a>
        <a href="/guides/tire-sizes" class="text-dark-400 hover:text-primary-400 text-xs transition-colors">Tire sizes explained</a>
      </div>
    </div>

    <!-- GTA cities served -->
    <div class="border-t border-dark-700/40 mt-6 pt-6">
      <h3 class="text-dark-500 text-xs font-semibold uppercase tracking-wider mb-3">Serving the GTA</h3>
      <div class="flex flex-wrap gap-x-4 gap-y-1.5">
        {cities.map(c => (
          <a href={`/wheels-tires-${c.slug}`} class="text-dark-400 hover:text-primary-400 text-xs transition-colors">{c.name}</a>
        ))}
      </div>
    </div>

    <div class="border-t border-dark-700/50 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-dark-500 text-xs">&copy; {new Date().getFullYear()} JSDC Wheels. All rights reserved.</p>
      <ul class="flex items-center gap-4">
        <li><a href="/privacy" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Terms of Service</a></li>
        <li><a href="/accessibility" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
