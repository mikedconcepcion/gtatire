---
---
<footer class="bg-dark-900 border-t border-dark-700/50 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center">
            <span class="text-dark-950 font-extrabold text-sm">JSDC</span>
          </div>
          <div>
            <div class="text-white font-bold text-lg">JSDC <span class="text-primary-400">Wheels</span></div>
          </div>
        </div>
        <p class="text-dark-400 text-sm max-w-md">
          Premium tires and wheels for the Greater Toronto Area.
          Top brands, competitive pricing, fast delivery.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Products</h3>
        <ul class="space-y-2">
          <li><a href="/gtatire/tires" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Tires</a></li>
          <li><a href="/gtatire/wheels" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Wheels</a></li>
          <li><a href="/gtatire/search" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Search</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Contact</h3>
        <ul class="space-y-2">
          <li><a href="mailto:james@jsdcwheels.ca" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">james@jsdcwheels.ca</a></li>
          <li><a href="/gtatire/contact" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Contact Us</a></li>
          <li><a href="/gtatire/login" class="text-dark-400 hover:text-primary-400 text-sm transition-colors">Distributor Login</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-dark-700/50 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-dark-500 text-xs">&copy; {new Date().getFullYear()} JSDC Wheels. All rights reserved.</p>
      <ul class="flex items-center gap-4">
        <li><a href="/gtatire/privacy" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Privacy Policy</a></li>
        <li><a href="/gtatire/terms" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Terms of Service</a></li>
        <li><a href="/gtatire/accessibility" class="text-dark-500 hover:text-dark-300 text-xs transition-colors">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
