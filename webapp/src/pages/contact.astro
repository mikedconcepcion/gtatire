---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — JSDC Wheels">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-white mb-2">Contact Us</h1>
    <p class="text-dark-400 mb-8">Get in touch for retail orders, wholesale account registration, fitment questions or support.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
      <div class="bg-dark-900 border border-dark-700/50 rounded-xl p-6">
        <div class="w-10 h-10 bg-dark-800 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Email</h3>
        <a href="mailto:james@jsdcwheels.ca" class="text-primary-400 text-sm hover:underline">james@jsdcwheels.ca</a>
      </div>

      <div class="bg-dark-900 border border-dark-700/50 rounded-xl p-6">
        <div class="w-10 h-10 bg-dark-800 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Location</h3>
        <p class="text-dark-400 text-sm">Greater Toronto Area, Ontario, Canada</p>
      </div>
    </div>

    <!-- Contact form -->
    <div class="bg-dark-900 border border-dark-700/50 rounded-xl p-6 sm:p-8">
      <h2 class="text-xl font-bold text-white mb-6">Send a Message</h2>
      <div id="contact-prefilled-banner" class="hidden mb-4 bg-primary-600/10 border border-primary-500/30 rounded-lg px-4 py-3">
        <p class="text-primary-300 text-xs uppercase tracking-wider font-semibold mb-1">Pre-filled inquiry</p>
        <p id="contact-prefilled-label" class="text-white text-sm"></p>
      </div>
      <form id="contact-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-dark-300 text-sm mb-1.5">Name</label>
            <input id="contact-name" type="text" required class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="Your name" />
          </div>
          <div>
            <label for="contact-email" class="block text-dark-300 text-sm mb-1.5">Email</label>
            <input id="contact-email" type="email" required class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="you@company.com" />
          </div>
        </div>
        <div>
          <label for="contact-company" class="block text-dark-300 text-sm mb-1.5">Company <span class="text-dark-500">(optional — leave blank if you're an individual buyer)</span></label>
          <input id="contact-company" type="text" class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="Tire shop name, if applicable" />
        </div>
        <div>
          <label for="contact-subject" class="block text-dark-300 text-sm mb-1.5">Subject</label>
          <input id="contact-subject" type="text" required class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" placeholder="What is your inquiry about?" />
        </div>
        <div>
          <label for="contact-message" class="block text-dark-300 text-sm mb-1.5">Message</label>
          <textarea id="contact-message" rows="5" required class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none" placeholder="How can we help you?"></textarea>
        </div>
        <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white font-semibold py-2.5 px-6 rounded-lg transition-colors text-sm">
          Send Message
        </button>
        <div id="contact-success" class="hidden text-green-400 text-sm mt-2">Your email client will open with the message pre-filled.</div>
      </form>

      <script is:inline>
        (function() {
          var params = new URLSearchParams(window.location.search);
          var subjPrefill = params.get('subject');
          var notePrefill = params.get('note');
          var labelPrefill = params.get('label') || subjPrefill;
          if (subjPrefill) {
            var subjEl = document.getElementById('contact-subject');
            if (subjEl) subjEl.value = subjPrefill;
          }
          if (notePrefill) {
            var msgEl = document.getElementById('contact-message');
            if (msgEl) msgEl.value = notePrefill + '\n\n';
          }
          if (subjPrefill || notePrefill) {
            var banner = document.getElementById('contact-prefilled-banner');
            var bannerLabel = document.getElementById('contact-prefilled-label');
            if (banner && bannerLabel) {
              banner.classList.remove('hidden');
              bannerLabel.textContent = labelPrefill || 'Your inquiry has been pre-filled below. Add your name and email, then send.';
            }
            // Move focus to name so the user can keep typing
            var nameEl = document.getElementById('contact-name');
            if (nameEl) nameEl.focus();
          }

          document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            var name = document.getElementById('contact-name').value;
            var email = document.getElementById('contact-email').value;
            var company = document.getElementById('contact-company').value;
            var subject = document.getElementById('contact-subject').value || (company ? 'Inquiry from ' + name + ' (' + company + ')' : 'Inquiry from ' + name);
            var message = document.getElementById('contact-message').value;
            var body = message + '\n\n---\nFrom: ' + name + '\nEmail: ' + email + (company ? '\nCompany: ' + company : '');
            window.location.href = 'mailto:james@jsdcwheels.ca?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
            document.getElementById('contact-success').classList.remove('hidden');
          });
        })();
      </script>
    </div>
  </section>
</Layout>
