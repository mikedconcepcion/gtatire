---
import Layout from '../layouts/Layout.astro';
import VehicleSearch from '../components/search/VehicleSearch';
---

<Layout title="Search — GTA Tire Distributor">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Find Tires & Wheels</h1>
      <p class="text-dark-400">Search by vehicle or type anything to find what you need</p>
    </div>

    <VehicleSearch client:load />
  </section>
</Layout>
