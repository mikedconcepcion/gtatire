---
import Layout from '../layouts/Layout.astro';
import HeroSearch from '../components/search/HeroSearch';
import fs from 'node:fs';
import path from 'node:path';

const statsPath = path.join(process.cwd(), 'public', 'data', 'stats.json');
let stats: any = {};
if (fs.existsSync(statsPath)) stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));

const wheelBrands = ['Superspeed', 'RWC', 'Macpek', 'OE+', 'Rocktrix', 'Blackhorn'];
const tireBrands = ['Michelin', 'Bridgestone', 'Continental', 'Pirelli', 'Goodyear', 'Hankook', 'Kumho', 'Yokohama'];
---

<Layout title="GTA Tire Distributor — Wholesale Tires & Wheels">
  <!-- Cinematic Intro Overlay -->
  <div id="hero-intro" class="fixed inset-0 z-[200] pointer-events-none" aria-hidden="true">
    <div class="hero-backdrop absolute inset-0 bg-dark-950"></div>

    <!-- Car sweeping across — low angle, wheel focused -->
    <div class="hero-car absolute inset-0 flex items-center overflow-hidden">
      <img
        src="https://cdn.imagin.studio/getImage?customer=img&make=BMW&modelFamily=M4&modelYear=2025&angle=05&width=1400&paintId=pspc0014&fileType=png"
        alt=""
        class="hero-car-img w-[140%] sm:w-[120%] max-w-none object-cover"
        loading="eager"
      />
    </div>

    <!-- Cinematic bars (letterbox) -->
    <div class="absolute top-0 left-0 right-0 h-[15%] bg-dark-950"></div>
    <div class="absolute bottom-0 left-0 right-0 h-[15%] bg-dark-950"></div>

    <!-- Speed lines -->
    <div class="hero-lines absolute inset-0 overflow-hidden">
      <div class="absolute top-[40%] left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary-400/60 to-transparent"></div>
      <div class="absolute top-[55%] left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
      <div class="absolute top-[65%] left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-primary-400/30 to-transparent"></div>
    </div>

    <!-- Flash wipe -->
    <div class="hero-flash absolute inset-y-0 w-[200px] bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-950/50 via-dark-950 to-dark-950"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary-600/10 rounded-full blur-3xl"></div>

    <div class="hero-content relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <div class="text-center mb-10">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4 tracking-tight">
          Find the Perfect
          <span class="text-primary-400"> Tires & Wheels</span>
        </h1>
        <p class="text-dark-300 text-lg sm:text-xl max-w-xl mx-auto">
          {stats.totalProducts?.toLocaleString() || '6,000+' } products from {Object.keys(stats.byBrand || {}).length || 40} brands.
          Search by vehicle, tire size, or wheel specs.
        </p>
      </div>

      <HeroSearch client:load />
    </div>
  </section>

  <style>
    /* ── Cinematic Intro: 1.5s — car sweeps through, Fast & Furious style ── */

    .hero-backdrop {
      animation: backdropOut 0.4s ease-out 1.1s forwards;
    }
    @keyframes backdropOut { to { opacity: 0; } }

    /* Car sweeps from right to left — fast pan */
    .hero-car {
      animation: carOut 0.4s ease-out 1.1s forwards;
    }
    .hero-car-img {
      animation: carSweep 1.5s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
    @keyframes carSweep {
      0%   { transform: translateX(30%) scale(1.1); opacity: 0; }
      15%  { opacity: 1; }
      40%  { transform: translateX(-5%) scale(1.05); opacity: 1; }
      70%  { transform: translateX(-15%) scale(1.0); opacity: 0.9; }
      100% { transform: translateX(-25%) scale(1.0); opacity: 0.7; }
    }
    @keyframes carOut { to { opacity: 0; } }

    /* Speed lines streak across */
    .hero-lines {
      animation: linesOut 0.3s ease-out 1.1s forwards;
    }
    .hero-lines div {
      animation: lineStreak 1.2s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
      transform: translateX(100%);
    }
    .hero-lines div:nth-child(1) { animation-delay: 0.1s; }
    .hero-lines div:nth-child(2) { animation-delay: 0.2s; }
    .hero-lines div:nth-child(3) { animation-delay: 0.15s; }
    @keyframes lineStreak {
      0%   { transform: translateX(100%); opacity: 0; }
      20%  { opacity: 1; }
      100% { transform: translateX(-100%); opacity: 0; }
    }
    @keyframes linesOut { to { opacity: 0; } }

    /* White flash wipe */
    .hero-flash {
      left: -200px;
      animation: flashWipe 0.5s ease-out 0.8s forwards;
    }
    @keyframes flashWipe {
      0%   { left: -200px; opacity: 0; }
      20%  { opacity: 1; }
      100% { left: 110%; opacity: 0; }
    }

    /* Content reveals after car passes */
    .hero-content {
      opacity: 0;
      animation: revealContent 0.5s ease-out 1.1s forwards;
    }
    @keyframes revealContent { to { opacity: 1; } }

    /* Kill overlay */
    #hero-intro {
      animation: killOverlay 0.01s linear 1.6s forwards;
    }
    @keyframes killOverlay { to { display: none; visibility: hidden; } }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      .hero-backdrop, .hero-car, .hero-car-img, .hero-lines,
      .hero-lines div, .hero-flash, .hero-content, #hero-intro {
        animation: none !important; opacity: 1 !important;
      }
      #hero-intro { display: none !important; }
    }
  </style>

  <!-- Wheel brands -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-6">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-5">Wheel Brands</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {wheelBrands.map(brand => (
        <a
          href={`/gtatire/search/?q=${encodeURIComponent(brand)}`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 px-4 py-2 rounded-xl text-sm font-semibold transition-all"
        >
          {brand}
        </a>
      ))}
      <a href="/gtatire/wheels" class="text-primary-400 hover:text-primary-300 bg-primary-600/10 hover:bg-primary-600/20 border border-primary-600/20 px-4 py-2 rounded-xl text-sm font-semibold transition-all">
        All Wheels →
      </a>
    </div>
  </section>

  <!-- Tire brands -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-5">Tire Brands</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {tireBrands.map(brand => (
        <a
          href={`/gtatire/search/?q=${encodeURIComponent(brand)}`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 px-4 py-2 rounded-xl text-sm font-semibold transition-all"
        >
          {brand}
        </a>
      ))}
      <a href="/gtatire/tires" class="text-primary-400 hover:text-primary-300 bg-primary-600/10 hover:bg-primary-600/20 border border-primary-600/20 px-4 py-2 rounded-xl text-sm font-semibold transition-all">
        All Tires →
      </a>
    </div>
  </section>

  <!-- Quick browse by size -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-6">Shop by Size</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {[15, 16, 17, 18, 19, 20, 21, 22].map(d => (
        <a
          href={`/gtatire/search/?q=${d}+inch`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 w-14 h-14 rounded-xl text-sm font-bold flex items-center justify-center transition-all"
        >
          {d}"
        </a>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/gtatire/wheels" class="group relative bg-dark-900 border border-dark-700/50 rounded-2xl p-8 hover:border-primary-600/50 transition-all overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/5 rounded-full -translate-y-8 translate-x-8 group-hover:bg-primary-600/10 transition-all"></div>
        <div class="relative">
          <div class="w-14 h-14 bg-dark-800 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2" />
              <path d="M12 2 L12 6 M12 18 L12 22 M2 12 L6 12 M18 12 L22 12" stroke-width="1.5" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Wheels</h3>
          <p class="text-dark-400 text-sm">2,150 steel and alloy wheels. Filter by brand, size, bolt pattern.</p>
          <div class="mt-4 text-primary-400 text-sm font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Browse Wheels
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <a href="/gtatire/tires" class="group relative bg-dark-900 border border-dark-700/50 rounded-2xl p-8 hover:border-primary-600/50 transition-all overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/5 rounded-full -translate-y-8 translate-x-8 group-hover:bg-primary-600/10 transition-all"></div>
        <div class="relative">
          <div class="w-14 h-14 bg-dark-800 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2" />
              <circle cx="12" cy="12" r="3" stroke-width="2" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Tires</h3>
          <p class="text-dark-400 text-sm">4,748 tires from 35 brands. All Season, Winter, All Weather.</p>
          <div class="mt-4 text-primary-400 text-sm font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Browse Tires
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <a href="/gtatire/login" class="group relative bg-gradient-to-br from-primary-900/50 to-dark-900 border border-primary-700/30 rounded-2xl p-8 hover:border-primary-600/50 transition-all overflow-hidden sm:col-span-2 lg:col-span-1">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/5 rounded-full -translate-y-8 translate-x-8 group-hover:bg-primary-600/10 transition-all"></div>
        <div class="relative">
          <div class="w-14 h-14 bg-primary-800/50 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Distributor Portal</h3>
          <p class="text-dark-400 text-sm">Sign in for wholesale pricing and order management.</p>
          <div class="mt-4 text-primary-400 text-sm font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Sign In
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Fast Delivery</h3>
        <p class="text-dark-400 text-sm">1-2 business day delivery across the GTA.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Best Prices</h3>
        <p class="text-dark-400 text-sm">10% off MSRP retail. Extra savings for registered distributors.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Quality Guaranteed</h3>
        <p class="text-dark-400 text-sm">All products from authorized suppliers with full warranty.</p>
      </div>
    </div>
  </section>
</Layout>
