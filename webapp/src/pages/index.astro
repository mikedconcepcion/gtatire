---
import Layout from '../layouts/Layout.astro';
import HeroSearch from '../components/search/HeroSearch';
import fs from 'node:fs';
import path from 'node:path';

const statsPath = path.join(process.cwd(), 'public', 'data', 'stats.json');
let stats: any = {};
if (fs.existsSync(statsPath)) stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));

const wheelBrands = ['Superspeed', 'RWC', 'Macpek', 'OE+', 'Rocktrix', 'Blackhorn'];
const tireBrands = ['Michelin', 'Bridgestone', 'Continental', 'Pirelli', 'Goodyear', 'Hankook', 'Kumho', 'Yokohama'];
---

<Layout title="JSDC Wheels — Premium Tires & Wheels in the GTA">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Background video (4s F&F-Canadian winter alloy on wet downtown Toronto).
         Plays ONCE on first visit per session — "showcase" intro — then
         settles to its last frame at reduced opacity for the rest of the
         session. SessionStorage flag skips the intro on repeat page loads.
         Reduced-motion users get only the poster image, never the video. -->
    <video
      id="hero-video"
      class="absolute inset-0 w-full h-full object-cover opacity-30 transition-opacity duration-700 ease-out motion-reduce:hidden"
      src="/videos/hero.mp4"
      poster="/videos/hero-poster.jpg"
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div
      class="absolute inset-0 bg-cover bg-center opacity-30 hidden motion-reduce:block"
      style="background-image: url('/videos/hero-poster.jpg');"
      aria-hidden="true"
    ></div>
    <script is:inline>
      (function () {
        var v = document.getElementById('hero-video');
        if (!v) return;
        var FLAG = 'jsdc_hero_intro_played';
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return; // CSS already hides the video
        var alreadyPlayed = false;
        try { alreadyPlayed = sessionStorage.getItem(FLAG) === '1'; } catch (e) {}

        function settle() {
          v.style.opacity = '0.3';
        }
        function showcase() {
          v.style.opacity = '0.75';
        }

        if (alreadyPlayed) {
          // Settled state on repeat loads — jump to last frame, low opacity.
          settle();
          v.addEventListener('loadedmetadata', function () {
            try { v.currentTime = Math.max(0, v.duration - 0.05); } catch (e) {}
          }, { once: true });
        } else {
          // First visit this session — full-impact showcase, then settle.
          showcase();
          var playPromise = v.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(function () {
              // Autoplay blocked — fall through to settled state
              settle();
              v.addEventListener('loadedmetadata', function () {
                try { v.currentTime = Math.max(0, v.duration - 0.05); } catch (e) {}
              }, { once: true });
            });
          }
          v.addEventListener('ended', function () {
            try { sessionStorage.setItem(FLAG, '1'); } catch (e) {}
            settle();
            // Pause on the last frame instead of looping or going black
            try { v.currentTime = Math.max(0, v.duration - 0.05); } catch (e) {}
          }, { once: true });
        }
      })();
    </script>
    <!-- Layered overlays: dark vignette + warm gold glow keep the headline crisp -->
    <div class="absolute inset-0 bg-gradient-to-b from-dark-950/70 via-dark-950/80 to-dark-950"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary-600/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
      <div class="text-center mb-10">
        <p class="text-primary-400 text-xs font-semibold uppercase tracking-[0.2em] mb-4 inline-flex items-center gap-2">
          <span class="h-px w-8 bg-primary-500/40"></span>
          Wholesale & Retail · GTA Distributor
          <span class="h-px w-8 bg-primary-500/40"></span>
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-5 tracking-tight">
          Find the Perfect
          <span class="text-primary-400"> Tires & Wheels</span>
        </h1>
        <p class="text-dark-300 text-lg sm:text-xl max-w-xl mx-auto">
          {(Math.floor((stats.totalProducts || 6800) / 100) * 100).toLocaleString()}+ products from {Object.keys(stats.byBrand || {}).length || 40} brands.
          Hub-centric fitment, 1-2 day delivery across the Greater Toronto Area.
        </p>
      </div>

      <HeroSearch client:load />
    </div>
  </section>

  <!-- Wheel brands -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-6">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-5">Wheel Brands</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {wheelBrands.map(brand => (
        <a
          href={`/search/?q=${encodeURIComponent(brand)}`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 px-4 py-2 rounded-xl text-sm font-semibold transition-all"
        >
          {brand}
        </a>
      ))}
      <a href="/wheels" class="text-primary-400 hover:text-primary-300 bg-primary-600/10 hover:bg-primary-600/20 border border-primary-600/20 px-4 py-2 rounded-xl text-sm font-semibold transition-all">
        All Wheels →
      </a>
    </div>
  </section>

  <!-- Tire brands -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-5">Tire Brands</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {tireBrands.map(brand => (
        <a
          href={`/search/?q=${encodeURIComponent(brand)}`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 px-4 py-2 rounded-xl text-sm font-semibold transition-all"
        >
          {brand}
        </a>
      ))}
      <a href="/tires" class="text-primary-400 hover:text-primary-300 bg-primary-600/10 hover:bg-primary-600/20 border border-primary-600/20 px-4 py-2 rounded-xl text-sm font-semibold transition-all">
        All Tires →
      </a>
    </div>
  </section>

  <!-- Quick browse by size -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-center text-dark-500 text-sm font-medium uppercase tracking-wider mb-6">Shop by Size</h2>
    <div class="flex flex-wrap justify-center gap-2">
      {[15, 16, 17, 18, 19, 20, 21, 22].map(d => (
        <a
          href={`/search/?q=${d}+inch`}
          class="text-dark-300 hover:text-white bg-dark-800/50 hover:bg-dark-800 border border-dark-700/50 hover:border-primary-600/30 w-14 h-14 rounded-xl text-sm font-bold flex items-center justify-center transition-all"
        >
          {d}"
        </a>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <a href="/wheels" class="group relative bg-dark-900 border border-dark-700/50 rounded-2xl p-8 hover:border-primary-600/50 transition-all overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/5 rounded-full -translate-y-8 translate-x-8 group-hover:bg-primary-600/10 transition-all"></div>
        <div class="relative">
          <div class="w-14 h-14 bg-dark-800 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2" />
              <path d="M12 2 L12 6 M12 18 L12 22 M2 12 L6 12 M18 12 L22 12" stroke-width="1.5" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Wheels</h3>
          <p class="text-dark-400 text-sm">2,150 steel and alloy wheels. Filter by brand, size, bolt pattern.</p>
          <div class="mt-4 text-primary-400 text-sm font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Browse Wheels
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

      <a href="/tires" class="group relative bg-dark-900 border border-dark-700/50 rounded-2xl p-8 hover:border-primary-600/50 transition-all overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/5 rounded-full -translate-y-8 translate-x-8 group-hover:bg-primary-600/10 transition-all"></div>
        <div class="relative">
          <div class="w-14 h-14 bg-dark-800 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2" />
              <circle cx="12" cy="12" r="3" stroke-width="2" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Tires</h3>
          <p class="text-dark-400 text-sm">4,748 tires from 35 brands. All Season, Winter, All Weather.</p>
          <div class="mt-4 text-primary-400 text-sm font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Browse Tires
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </div>
        </div>
      </a>

    </div>
  </section>

  <!-- Features -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Fast Delivery</h3>
        <p class="text-dark-400 text-sm">1-2 business day delivery across the GTA.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Wholesale Pricing</h3>
        <p class="text-dark-400 text-sm">Sharper than retail. Tiered savings for registered distributors and tire shops.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-dark-800 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Authorized Distributor</h3>
        <p class="text-dark-400 text-sm">Sourced direct from Michelin, Bridgestone, Continental and 40+ brands — full manufacturer warranty.</p>
      </div>
    </div>
  </section>
</Layout>
