---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductDetail from '../../components/ProductDetail';
import CompatibleProducts from '../../components/CompatibleProducts';
import fs from 'node:fs';
import path from 'node:path';

const productsPath = path.join(process.cwd(), 'public', 'data', 'products.json');
let allProducts: any[] = [];
if (fs.existsSync(productsPath)) allProducts = JSON.parse(fs.readFileSync(productsPath, 'utf-8'));

const { id } = Astro.params;
const product = allProducts.find(p => p.id === id);

const similar = product
  ? allProducts
      .filter(p => p.id !== product.id && p.category === 'tire' && p.rimDiameter === product.rimDiameter && p.tireWidth === product.tireWidth)
      .slice(0, 5)
  : [];

const specs = product ? [
  { label: 'SKU', value: product.sku },
  { label: 'Brand', value: product.brand || null },
  { label: 'Model', value: product.name || null },
  { label: 'Type', value: product.wheelType },
  { label: 'Size', value: product.tireSize || null },
  { label: 'Rim Diameter', value: product.rimDiameter ? `${product.rimDiameter}"` : null },
].filter(s => s.value) : [];

export async function getStaticPaths() {
  const pPath = path.join(process.cwd(), 'public', 'data', 'products.json');
  if (!fs.existsSync(pPath)) return [];
  const products = JSON.parse(fs.readFileSync(pPath, 'utf-8'));
  return products.filter((p: any) => p.category === 'tire').map((p: any) => ({ params: { id: p.id } }));
}
---

<Layout title={product ? `${product.brand} ${product.name} ${product.tireSize || ''} — GTA Tire` : 'Not Found'}>
  {product ? (
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6">
      <nav class="flex items-center gap-2 text-xs text-dark-500 mb-4">
        <a href="/gtatire/" class="hover:text-dark-300">Home</a>
        <span>/</span>
        <a href="/gtatire/tires" class="hover:text-dark-300">Tires</a>
        <span>/</span>
        <span class="text-dark-300">{product.brand} {product.name}</span>
      </nav>

      <ProductDetail
        client:load
        product={product}
        vehicles={[]}
        specs={specs}
      />

      <!-- Compatible wheels for this tire -->
      {product.rimDiameter && (
        <CompatibleProducts
          client:load
          productCategory="tire"
          rimDiameter={product.rimDiameter}
          priceNum={product.priceNum}
        />
      )}

      {similar.length > 0 && (
        <div>
          <h2 class="text-sm font-semibold text-white mb-3">Similar Tires</h2>
          <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
            {similar.map(p => (
              <ProductCard
                id={p.id}
                image={p.image}
                brand={p.brand}
                model={p.name}
                description={p.description}
                size={p.tireSize || ''}
                price={p.price}
                compareAt={p.compareAt}
                stock={p.stock}
                type={p.wheelType}
                category="tire"
              />
            ))}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h1 class="text-2xl font-bold text-white mb-4">Product Not Found</h1>
      <a href="/gtatire/tires" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition-colors">Browse Tires</a>
    </div>
  )}
</Layout>
