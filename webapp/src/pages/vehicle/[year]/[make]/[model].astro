---
import Layout from '../../../../layouts/Layout.astro';
import VehicleSearch from '../../../../components/search/VehicleSearch';
import VehicleResults from '../../../../components/VehicleResults';
import fs from 'node:fs';
import path from 'node:path';

const productsPath = path.join(process.cwd(), 'public', 'data', 'products.json');
const fitmentPath = path.join(process.cwd(), 'public', 'data', 'fitment.json');
const vehiclesPath = path.join(process.cwd(), 'public', 'data', 'vehicles.json');

let allProducts: any[] = [];
let fitment: Record<string, string[]> = {};
let vehicles: any = {};

if (fs.existsSync(productsPath)) allProducts = JSON.parse(fs.readFileSync(productsPath, 'utf-8'));
if (fs.existsSync(fitmentPath)) fitment = JSON.parse(fs.readFileSync(fitmentPath, 'utf-8'));
if (fs.existsSync(vehiclesPath)) vehicles = JSON.parse(fs.readFileSync(vehiclesPath, 'utf-8'));

const { year, make, model } = Astro.params;
const vehicleKey = `${year}|${make}|${model}`;

// Find matching products
const matchingProductNos = new Set<string>();
for (const [productNo, vehicleList] of Object.entries(fitment)) {
  if (vehicleList.includes(vehicleKey)) {
    matchingProductNos.add(productNo);
  }
}
const products = allProducts.filter(p => matchingProductNos.has(p.productNo));
const availableDiameters = vehicles?.[year!]?.[make!]?.[model!] || [];

export async function getStaticPaths() {
  const vPath = path.join(process.cwd(), 'public', 'data', 'vehicles.json');
  if (!fs.existsSync(vPath)) return [];
  const v = JSON.parse(fs.readFileSync(vPath, 'utf-8'));
  const paths = [];
  for (const yr of Object.keys(v)) {
    for (const mk of Object.keys(v[yr])) {
      for (const md of Object.keys(v[yr][mk])) {
        paths.push({ params: { year: yr, make: mk, model: md } });
      }
    }
  }
  return paths;
}

const displayMake = make ? make.charAt(0) + make.slice(1).toLowerCase() : '';
const displayModel = model || '';
const steelCount = products.filter((p: any) => p.wheelType === 'Steel Wheel').length;
const alloyCount = products.filter((p: any) => p.wheelType === 'Alloy Wheel').length;
---

<Layout title={`${year} ${displayMake} ${displayModel} — Wheels & Tires`}>
  <!-- Vehicle header -->
  <section class="bg-dark-900 border-b border-dark-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <a href="/gtatire/" class="text-dark-500 hover:text-dark-300 text-sm transition-colors inline-flex items-center gap-1 mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Back to Search
          </a>
          <h1 class="text-3xl sm:text-4xl font-bold text-white">
            {year} {make} <span class="text-primary-400">{displayModel}</span>
          </h1>
          <p class="text-dark-400 mt-1">
            {products.length} wheel{products.length !== 1 ? 's' : ''} available
            {availableDiameters.length > 0 && (
              <span> · Fits {availableDiameters.map((d: string) => `${d}"`).join(', ')} rims</span>
            )}
          </p>
        </div>
        <div class="flex gap-3 text-sm">
          <div class="bg-dark-800 border border-dark-700/50 rounded-lg px-4 py-2 text-center">
            <div class="text-white font-bold text-lg">{steelCount}</div>
            <div class="text-dark-500 text-xs">Steel</div>
          </div>
          <div class="bg-dark-800 border border-dark-700/50 rounded-lg px-4 py-2 text-center">
            <div class="text-primary-400 font-bold text-lg">{alloyCount}</div>
            <div class="text-dark-500 text-xs">Alloy</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive results with filtering -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    {products.length > 0 ? (
      <VehicleResults
        client:load
        products={products}
        availableDiameters={availableDiameters}
      />
    ) : (
      <div class="text-center py-20">
        <svg class="w-16 h-16 text-dark-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h3 class="text-white font-semibold text-lg mb-2">No wheels found for this vehicle</h3>
        <p class="text-dark-500 text-sm max-w-md mx-auto mb-6">
          We don't have wheel data for the {year} {displayMake} {displayModel} yet.
        </p>
        <div class="flex justify-center gap-3">
          <a href="/gtatire/" class="bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">
            Search Again
          </a>
          <a href="/gtatire/wheels" class="bg-dark-800 hover:bg-dark-700 text-dark-300 hover:text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors border border-dark-600">
            Browse All Wheels
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- Search again -->
  {products.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-dark-700/30">
      <div class="text-center mb-6">
        <h3 class="text-white font-semibold">Search for a different vehicle</h3>
      </div>
      <VehicleSearch client:load />
    </section>
  )}
</Layout>
