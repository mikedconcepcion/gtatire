---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load products at build time
const dataPath = path.join(process.cwd(), 'public', 'data', 'products.json');
let products: any[] = [];
if (fs.existsSync(dataPath)) {
  products = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
}

// Get unique filter values
const types = [...new Set(products.map(p => p.wheelType))].filter(Boolean).sort();
const brands = [...new Set(products.map(p => p.brand))].filter(Boolean).sort();
const diameters = [...new Set(products.map(p => p.rimDiameter))].filter(Boolean).sort((a, b) => a - b);
const finishes = [...new Set(products.map(p => p.finish))].filter(Boolean).sort();
const boltPatterns = [...new Set(products.map(p => p.boltPattern))].filter(Boolean).sort();
---

<Layout title="Wheels — GTA Tire Distributor">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white">Wheels</h1>
        <p class="text-dark-400 text-sm mt-1">{products.length} products available</p>
      </div>
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2">
        <select id="filter-brand" class="bg-dark-800 border border-dark-600 text-dark-300 text-xs rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">All Brands</option>
          {brands.map(b => <option value={b}>{b}</option>)}
        </select>
        <select id="filter-diameter" class="bg-dark-800 border border-dark-600 text-dark-300 text-xs rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">All Sizes</option>
          {diameters.map(d => <option value={d}>{d}"</option>)}
        </select>
        <select id="filter-bolt" class="bg-dark-800 border border-dark-600 text-dark-300 text-xs rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">All Bolts</option>
          {boltPatterns.map(b => <option value={b}>{b}</option>)}
        </select>
        <select id="filter-sort" class="bg-dark-800 border border-dark-600 text-dark-300 text-xs rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="price-asc">Price: Low</option>
          <option value="price-desc">Price: High</option>
          <option value="stock">In Stock</option>
        </select>
      </div>
    </div>

    <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      {products.slice(0, 50).map(p => (
        <ProductCard
          id={p.id}
          image={p.image}
          brand={p.brand || p.supplier}
          model={p.name || p.description.split(' ')[0]}
          description={p.description}
          size={p.boltPattern ? `${p.rimDiameter}" · ${p.boltPattern}` : `${p.rimDiameter}"`}
          price={p.price}
          compareAt={p.compareAt}
          stock={p.stock}
          type={p.wheelType}
          category="wheel"
        />
      ))}
    </div>

    {products.length > 50 && (
      <div class="text-center mt-8">
        <button id="load-more" class="bg-dark-800 hover:bg-dark-700 text-dark-300 hover:text-white px-6 py-3 rounded-lg text-sm font-medium transition-colors border border-dark-600">
          Load More ({products.length - 50} remaining)
        </button>
      </div>
    )}
  </section>
</Layout>
