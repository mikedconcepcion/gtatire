---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — GTA Tire Distributor">
  <section class="max-w-md mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="text-6xl font-bold text-dark-700 mb-4">404</div>
    <h1 class="text-xl font-bold text-white mb-2">Page Not Found</h1>
    <p class="text-dark-400 text-sm mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <div class="flex justify-center gap-3">
      <a href="/gtatire/" class="bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">
        Go Home
      </a>
      <a href="/gtatire/wheels" class="bg-dark-800 hover:bg-dark-700 text-dark-300 hover:text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors border border-dark-600">
        Browse Wheels
      </a>
    </div>
  </section>
</Layout>
