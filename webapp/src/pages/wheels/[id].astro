---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductDetail from '../../components/ProductDetail';
import CompatibleProducts from '../../components/CompatibleProducts';
import fs from 'node:fs';
import path from 'node:path';

const productsPath = path.join(process.cwd(), 'public', 'data', 'products.json');
const fitmentPath = path.join(process.cwd(), 'public', 'data', 'fitment.json');

let allProducts: any[] = [];
let fitment: Record<string, string[]> = {};

if (fs.existsSync(productsPath)) allProducts = JSON.parse(fs.readFileSync(productsPath, 'utf-8'));
if (fs.existsSync(fitmentPath)) fitment = JSON.parse(fs.readFileSync(fitmentPath, 'utf-8'));

const { id } = Astro.params;
const product = allProducts.find(p => p.id === id);

// Fitment data (shown only to distributors via React component)
const vehicleKeys = product ? (fitment[product.productNo] || []) : [];
const vehicles = vehicleKeys.map(k => {
  const [year, make, model] = k.split('|');
  return { year, make, model, url: `/vehicle/${year}/${make}/${model}` };
});

const similar = product
  ? allProducts
      .filter(p => p.id !== product.id && p.rimDiameter === product.rimDiameter && p.boltPattern === product.boltPattern)
      .slice(0, 5)
  : [];

const specs = product ? [
  { label: 'SKU', value: product.productNo },
  { label: 'Brand', value: product.brand || null },
  { label: 'Type', value: product.wheelType },
  { label: 'Size', value: product.rimDiameter && product.rimWidth ? `${product.rimDiameter}x${product.rimWidth}` : null },
  { label: 'Bolt Pattern', value: product.boltPattern || null },
  { label: 'Offset', value: product.offset !== null ? `ET${product.offset}` : null },
  { label: 'Hub Bore', value: product.hubBore ? `${product.hubBore}mm` : null },
  { label: 'Finish', value: product.finish || null },
  { label: 'Seat', value: product.seat || null },
  { label: 'Hub Centric', value: product.hubCentric ? 'Yes' : 'No' },
  { label: 'TPMS', value: product.tpmsCompatible || null },
  { label: 'Runflat', value: product.runflatCertified || null },
  { label: 'Load Rating', value: product.loadRating || null },
].filter(s => s.value) : [];

export async function getStaticPaths() {
  const pPath = path.join(process.cwd(), 'public', 'data', 'products.json');
  if (!fs.existsSync(pPath)) return [];
  const products = JSON.parse(fs.readFileSync(pPath, 'utf-8'));
  return products.filter((p: any) => p.category === 'wheel').map((p: any) => ({ params: { id: p.id } }));
}
---

<Layout title={product ? `${product.name || product.description} — JSDC Wheels` : 'Not Found'}>
  {product ? (
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-dark-500 mb-4">
        <a href="/" class="hover:text-dark-300">Home</a>
        <span>/</span>
        <a href="/wheels" class="hover:text-dark-300">Wheels</a>
        <span>/</span>
        <span class="text-dark-300">{product.productNo}</span>
      </nav>

      <!-- Product detail — React component handles auth-aware display -->
      <ProductDetail
        client:load
        product={product}
        vehicles={vehicles}
        specs={specs}
      />

      <!-- Compatible tires & wheels -->
      {product.rimDiameter && (
        <CompatibleProducts
          client:load
          productCategory="wheel"
          rimDiameter={product.rimDiameter}
          boltPattern={product.boltPattern}
          priceNum={product.priceNum}
        />
      )}

      <!-- Similar -->
      {similar.length > 0 && (
        <div>
          <h2 class="text-sm font-semibold text-white mb-3">Similar Wheels</h2>
          <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
            {similar.map(p => (
              <ProductCard
                id={p.id}
                image={p.image}
                brand={p.brand || p.supplier}
                model={p.name || p.description.split(' ')[0]}
                description={p.description}
                size={p.boltPattern ? `${p.rimDiameter}" · ${p.boltPattern}` : `${p.rimDiameter}"`}
                price={p.price}
                compareAt={p.compareAt}
                stock={p.stock}
                type={p.wheelType}
                category="wheel"
                noImage={p.noImage}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h1 class="text-2xl font-bold text-white mb-4">Product Not Found</h1>
      <a href="/wheels" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition-colors">Browse Wheels</a>
    </div>
  )}
</Layout>
