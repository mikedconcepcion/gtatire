---
// Parametric SSG for every wheel detail page (~2,137). Same idea as the
// vehicle route: server-render the SEO chrome (title, meta, JSON-LD,
// canonical, h1 from product fields) and let the React hydrator handle
// the interactive bits.
import Layout from '../../layouts/Layout.astro';
import WheelDetailPage from '../../components/detail/WheelDetailPage';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const pPath = path.join(process.cwd(), 'public', 'data', 'products.json');
  if (!fs.existsSync(pPath)) return [];
  const products = JSON.parse(fs.readFileSync(pPath, 'utf-8'));
  return products
    .filter((p: any) => p.category === 'wheel')
    .map((p: any) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props as { product: any };
const { id } = Astro.params;

// Build the headline once, then build the description on the same parts so
// they don't echo each other. The product `.name` is often already the size
// (e.g. "17x7"), so we only append size if it adds new info.
const sizeShort = product.rimDiameter && product.rimWidth ? `${product.rimDiameter}x${product.rimWidth}` : '';
const nameHasSize = sizeShort && (product.name || '').includes(sizeShort);
const headlineParts = [
  product.brand,
  product.name,
  nameHasSize ? '' : sizeShort,
  product.boltPattern,
].filter(Boolean);
const headline = headlineParts.join(' ').replace(/\s+/g, ' ').trim() || product.description || id;
const title = `${headline} — Wheel | JSDC Wheels`;
const description = [
  product.wheelType || 'Wheel',
  product.finish ? `in ${product.finish}` : '',
  sizeShort ? `· ${sizeShort}` : '',
  product.boltPattern ? `· ${product.boltPattern}` : '',
  product.hubCentric ? '· hub centric' : '',
  product.price ? `· from ${product.price}` : '',
  '· ships from the GTA',
].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': headline,
  'sku': product.id,
  'brand': { '@type': 'Brand', 'name': product.brand || 'JSDC Wheels' },
  'category': 'Wheels',
  ...(product.image ? { 'image': product.image } : {}),
  'description': product.description || description,
  ...(product.priceNum > 0 ? {
    'offers': {
      '@type': 'Offer',
      'price': product.priceNum,
      'priceCurrency': 'CAD',
      'availability': /out of stock/i.test(String(product.stock || ''))
        ? 'https://schema.org/OutOfStock'
        : 'https://schema.org/InStock',
      'url': `https://jsdcwheels.ca/wheels/${id}`,
      'seller': { '@type': 'AutoPartsStore', 'name': 'JSDC Wheels' },
    },
  } : {}),
};
---

<Layout title={title} description={description} ogImage={product.image} jsonLd={jsonLd}>
  <WheelDetailPage client:load />
</Layout>
